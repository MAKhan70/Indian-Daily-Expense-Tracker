generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                    String           @id
  name                  String
  email                 String           @unique
  emailVerified         Boolean          @default(false)
  image                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  sessions              Session[]
  accounts              Account[]
  expenses              Expense[]
  expenseArchives       ExpenseArchive[]
  monthlyBudgets        MonthlyBudget[]
  paymentAccounts       PaymentAccount[]
  preference            UserPreference?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Expense {
  id              String   @id
  userId          String
  name            String
  merchant        String   @default("")
  amountMinor     Int
  categoryGroup   String
  category        String
  subcategory     String
  frequency       String
  payment         String
  date            String
  time            String
  status          String   @default("actual")
  planNote        String   @default("")
  reminder        String   @default("none")
  color           String   @default("sage")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, payment])
  @@index([userId, frequency])
}

model ExpenseArchive {
  id              String   @id
  sourceExpenseId String
  userId          String
  name            String
  merchant        String   @default("")
  amountMinor     Int
  categoryGroup   String
  category        String
  subcategory     String
  frequency       String
  payment         String
  date            String
  time            String
  status          String
  planNote        String   @default("")
  reminder        String   @default("none")
  color           String   @default("sage")
  archiveReason   String
  archivedAt      DateTime
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt])
  @@index([sourceExpenseId])
}

model MonthlyBudget {
  id          String   @id @default(uuid())
  userId      String
  month       String
  amountMinor Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

model PaymentAccount {
  id                 String   @id @default(uuid())
  userId             String
  kind               String
  slot               Int
  paymentId          String
  label              String
  merchant           String   @default("")
  definedAmountMinor Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, slot])
  @@unique([userId, paymentId])
  @@index([userId])
}

model UserPreference {
  userId               String   @id
  dark                 Boolean  @default(false)
  profilePhoto         String?
  localImportCompleted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
