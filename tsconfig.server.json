{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist/api",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "prisma.config.ts"]
}
