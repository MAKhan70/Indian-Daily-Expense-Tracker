# Local development uses SQLite. Never commit the real production database URL or auth secret.
DATABASE_URL="file:./dev.db"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3001"
# On Railway, BETTER_AUTH_URL is derived from RAILWAY_PUBLIC_DOMAIN automatically.
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:3001"
TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"
PORT="3001"

# Optional production email delivery for verification and password resets.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Pocket Ledger <no-reply@example.com>"
REQUIRE_EMAIL_VERIFICATION="false"
