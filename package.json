{
  "name": "expense-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build && node scripts/prepare-sites-build.mjs",
    "start": "npm run db:deploy && node dist/api/server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/deploy-sqlite.mjs",
    "db:deploy": "node scripts/deploy-sqlite.mjs",
    "db:deploy:prisma": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^10.0.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  }
}
